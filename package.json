{
  "name": "JCh-code-tree",
  "displayName": "Code File & Function Tree",
  "description": "Tree view of workspace files (pl/pm/cgi/html/js/css/ts/tsx/sh/json, plus shebang scripts) with Perl/JS/TS/shell functions nested underneath, synced with the cursor.",
  "version": "0.0.30",
  "publisher": "jchakarov",
  "icon": "media/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "JChCodeTreeContainer",
          "title": "Code Tree",
          "icon": "media/tree-icon.svg"
        }
      ]
    },
    "views": {
      "JChCodeTreeContainer": [
        {
          "id": "JChCodeTree",
          "name": "Code Tree"
        }
      ]
    },
    "commands": [
      {
        "command": "JChCodeTree.refresh",
        "title": "Code Tree: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "JChCodeTree.openSelectedFile",
        "title": "Code Tree: Open Selected File"
      },
      {
        "command": "JChCodeTree.checkForUpdates",
        "title": "Code Tree: Check for Updates"
      },
      {
        "command": "JChCodeTree.showIncludedBy",
        "title": "Code Tree: Show Included By"
      },
      {
        "command": "JChCodeTree.copyName",
        "title": "Copy Name"
      },
      {
        "command": "JChCodeTree.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "JChCodeTree.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "JChCodeTree.revealInExplorer",
        "title": "Reveal in Explorer View"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "JChCodeTree.refresh",
          "when": "view == JChCodeTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "JChCodeTree.openToSide",
          "when": "view == JChCodeTree && viewItem =~ /^(file|template|function)$/",
          "group": "1_open@1"
        },
        {
          "command": "JChCodeTree.revealInExplorer",
          "when": "view == JChCodeTree && viewItem =~ /^(file|template|folder)$/",
          "group": "1_open@2"
        },
        {
          "command": "JChCodeTree.showIncludedBy",
          "when": "view == JChCodeTree && viewItem == template",
          "group": "1_open@3"
        },
        {
          "command": "JChCodeTree.copyName",
          "when": "view == JChCodeTree && viewItem =~ /^(function|package)$/",
          "group": "2_copy@1"
        },
        {
          "command": "JChCodeTree.copyRelativePath",
          "when": "view == JChCodeTree",
          "group": "2_copy@2"
        }
      ],
      "commandPalette": [
        { "command": "JChCodeTree.copyName", "when": "false" },
        { "command": "JChCodeTree.copyRelativePath", "when": "false" },
        { "command": "JChCodeTree.openToSide", "when": "false" },
        { "command": "JChCodeTree.revealInExplorer", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Code Tree",
      "properties": {
        "JChCodeTree.extensions": {
          "type": "object",
          "default": {
            ".pl": "perl", ".pm": "perl", ".cgi": "perl",
            ".js": "js", ".ts": "js", ".tsx": "js",
            ".sh": "sh",
            ".html": "html", ".css": "none", ".json": "none"
          },
          "additionalProperties": {
            "type": "string",
            "enum": ["perl", "js", "html", "sh", "none", "hide"],
            "enumDescriptions": [
              "Shown, with Perl subs underneath",
              "Shown, with JS/TS functions underneath",
              "Shown, with the JS functions from its <script> blocks underneath",
              "Shown, with shell functions underneath",
              "Shown, without functions",
              "Not shown (use this to remove one of the defaults)"
            ]
          },
          "markdownDescription": "File extensions shown in the tree, and which parser finds their functions. E.g. `\".t\": \"perl\"`, `\".tmpl\": \"none\"`, `\".json\": \"hide\"`. Extensionless shell scripts are detected by their shebang regardless."
        },
        "JChCodeTree.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Glob patterns, relative to the workspace folder, of files and folders to leave out of the tree (on top of `#files.exclude#`). E.g. `**/logs`, `tmp`, `**/*.min.js`."
        },
        "JChCodeTree.showHiddenFiles": {
          "type": "boolean",
          "default": false,
          "description": "Show files and folders whose name starts with a dot."
        },
        "JChCodeTree.showSymlinks": {
          "type": "boolean",
          "default": false,
          "description": "Show files and folders reached through a symlink (under the link's path). Walks folders directly, independent of search.followSymlinks."
        },
        "JChCodeTree.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "On startup (and every autoUpdateIntervalHours), install a newer version from github.com/JekoCh/JChCodeTree if one is published."
        },
        "JChCodeTree.autoUpdateIntervalHours": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "scope": "machine",
          "description": "While a window is open, check for a newer version every this many hours (only when autoUpdate is on). 0 = check on startup only."
        }
      }
    },
    "keybindings": [
      {
        "command": "JChCodeTree.openSelectedFile",
        "key": "alt+o",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
