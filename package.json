{
  "name": "jch-code-tree",
  "displayName": "Code File & Function Tree",
  "description": "Tree view of workspace files (pl/pm/cgi/html/js/css) with Perl/JS functions nested underneath, synced with the cursor.",
  "version": "0.0.6",
  "publisher": "jchakarov",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:jchCodeTree"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jchCodeTreeContainer",
          "title": "Code Tree",
          "icon": "media/tree-icon.svg"
        }
      ]
    },
    "views": {
      "jchCodeTreeContainer": [
        {
          "id": "jchCodeTree",
          "name": "Code Tree"
        }
      ]
    },
    "commands": [
      {
        "command": "jchCodeTree.refresh",
        "title": "Code Tree: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "jchCodeTree.openInEditor",
        "title": "Code Tree: Open in Editor Tab",
        "icon": "$(multiple-windows)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jchCodeTree.refresh",
          "when": "view == jchCodeTree",
          "group": "navigation"
        },
        {
          "command": "jchCodeTree.openInEditor",
          "when": "view == jchCodeTree",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
